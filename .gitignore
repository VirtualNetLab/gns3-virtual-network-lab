########################################
# WireGuard secrets and configs
########################################

# WireGuard stack runtime data (NEVER commit)
docker/wireguard-stack/wg-config/
docker/wireguard-stack/wgdashboard-data/
docker/wireguard-stack/portainer-data/

# Safety nets (in case paths change)
**/wg-config/
**/wg_confs/
**/wgdashboard-data/
**/portainer-data/

**/privatekey*
**/publickey*
**/presharedkey*
**/wg0.conf

########################################
# GNS3 runtime files
########################################

# GNS3 projects, images, and runtime data
docker/gns3/GNS3/

# Per-user container instances
docker/gns3/instances/

# GNS3 temporary files
*.gns3~
*.log
*.tmp

########################################
# Environment files
########################################

.env
.env.*
**/.env

########################################
# Runtime data
########################################

data/
logs/
runtime/

########################################
# Docker runtime
########################################

docker-compose.override.yml
docker-compose.local.yml

########################################
# Linux temp
########################################

*~
*.swp
*.swo

########################################
# IDE
########################################

.vscode/
.idea/

########################################
# OS
########################################

.DS_Store
Thumbs.db

########################################
# Python cache
########################################

__pycache__/
*.pyc

########################################
# Terraform
########################################

.terraform/
*.tfstate
*.tfstate.*
